<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet-git-tool</AssemblyName>
    <RootNamespace>DotnetGitTool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-git-tool</ToolCommandName>
    <PackageId>JKToolKit.Git.Tool</PackageId>
    <Version>0.0.1</Version>
    <Description>Build and install .NET global tools directly from Git repositories.</Description>
    <Authors>JKamsker</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/JKamsker/dotnet-git-tool</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JKamsker/dotnet-git-tool.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-tool;git;source;cli</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet-git-tool</AssemblyName>
    <RootNamespace>DotnetGitTool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-git-tool</ToolCommandName>
    <PackageId>dotnet-git-tool</PackageId>
    <Version>0.4.0</Version>
    <Description>Build and install .NET global tools directly from Git repositories.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
